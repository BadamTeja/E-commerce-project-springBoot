pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                dir('JtProject') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }


        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'JtProject/target/*.jar', fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying Application..."
                sh 'echo Deployment Successful'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline succeeded!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}
